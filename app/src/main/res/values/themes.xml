<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema base; Compose dibuja toda la interfaz. -->
    <style name="Theme.Quipu" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Pantalla de inicio (SplashScreen API, compatible con Android 11+). -->
    <style name="Theme.Quipu.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/icon_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Quipu</item>
    </style>
</resources>
